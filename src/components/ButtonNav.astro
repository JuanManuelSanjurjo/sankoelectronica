---
const { sections } = Astro.props; // sections es un array con los IDs y nombres de las secciones
---
<nav class="vertical-nav glass">
  {sections.map((section, index) => (
    <a 
      href={`#${section.id}`} 
      class="nav-point" 
      title={section.name}
      aria-label={`Navigate to ${section.name}`}
    >
      <span class="dot"></span>
    </a>
  ))}
</nav>

<style>
.vertical-nav {
  position: fixed;
  top: 50%;
  left: 10px;
  transform: translateY(-50%);
  background-color: rgba(0,0,0,0.5);
  padding: 20px 10px;
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  gap: 30px;
  z-index: 10;
}

/* Estilos básicos para cada punto */
.nav-point {
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
}

.nav-point .dot {
  width: 12px;
  height: 12px;
  background-color: white;
  border-radius: 100px;
  transition: all 0.2s ease;
}
 .nav-point .dot.active {
    height: 40px;
 }
 @media (max-width: 1150px) {
  .vertical-nav {
    display: none;
  }
}
</style>


<script>
document.addEventListener('astro:page-load', () => { // en este caso no haria falta pq el evento se añade en scroll
    document.addEventListener('scroll', () => {
      const sections = document.querySelectorAll('section');
      const navPoints = document.querySelectorAll('.nav-point .dot');

      sections.forEach((section, index) => {
        const rect = section.getBoundingClientRect();
        if (rect.top >= 0 && rect.top <= window.innerHeight / 2) {
          navPoints.forEach(dot => dot.classList.remove('active'));
          navPoints[index].classList.add('active');
        }
      });
    });
  });
</script>

