---
import {Image} from 'astro:assets';
const { image, alt, href } = Astro.props;

---
<a href={href} class="hero-card-container glass">
  <div class="hero-card">
    <Image transition:name={alt} class="image" src={image} alt={alt} width="170px" height="170px" />
  </div>  
  <h4>{alt}</h4>
</a>

<style>
  .hero-card-container {
    box-shadow: 0px 0px 2px 1px var(--black);
    /* border-radius: 10px; */
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 3rem;
    text-decoration: none;
  }
 .hero-card {
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
    border-radius: 50%;
    background-color: white; 
    width: 275px;
    height: 275px;
    transition: all 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
  }

  .image {
    padding: 10px; 
    object-fit: contain; 
    width: 175px; 
    height: 175px; 
  }

  .hero-card-container:hover .hero-card {
    transform: scale(1.04);
    filter: brightness(1.1);
    box-shadow: 4px 4px 15px rgba(0, 0, 0, 0.5);
  }
  h4{
    position: relative;
    height: 100px;
    display: flex;
    justify-content: center;
    width: 100%;
    text-transform: uppercase;
    font-size: 1.5rem;
    background: rgba(0,0,0, 0.3);
    align-items: center;
    min-height: 100px;
    color: white;
    transition: 0.3s ease-in-out;
    padding: 1rem;
    max-width: 275px;
    z-index: 1;
  }
  h4::before{
    content: "";
    position: absolute;
    inset: 0;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background-color: var(--accent-blue);
    background-color: var(--frame);
    transition:  0.2s  cubic-bezier(0.455, 0.03, 0.515, 0.955);
    z-index: -1;
  }
  .hero-card-container:hover h4::before { 
    transform: scaleX(1);
    box-shadow: 4px 4px 0px 0px var(--frame);
    box-shadow: 4px 4px 0px 0px white;
   }
  @media (max-width: 1345px) {
    h4::before{
    transform: scaleX(1);
    }
    .hero-card-container {
      padding: 1rem;
      gap: 1rem;
    }
    image {
      width: 160px; 
      height: 160px; 
    }
  }
</style>


