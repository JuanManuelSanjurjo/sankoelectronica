---
import {Image} from 'astro:assets';
const { image, alt, href } = Astro.props;

---
<a href={href} class="hero-card-container glass">
  <div class="hero-card">
    <Image class="image" src={image} alt={alt} width="190px" height="190px" />
  </div>  
  <h4>{alt}</h4>
</a>

<style>
  .hero-card-container {
    box-shadow: 0px 0px 2px 2px var(--black);
    padding: 2rem;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1rem;
    text-decoration: none;
  }
 .hero-card {
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
    border-radius: 50%; /* Hace que el contenedor sea circular */
    background-color: white; /* Color del círculo */
    width: 275px; /* Ancho del círculo */
    height: 275px; /* Altura del círculo (igual al ancho para mantenerlo circular) */
    transition: all 0.4s ease-in-out, box-shadow 0.2s ease-in-out;
  }

  .image {
    padding: 10px; /* Espaciado interno entre la imagen y el borde del círculo */
    object-fit: contain; /* Asegura que la imagen se ajuste correctamente */
    width: 190px; /* Ancho de la imagen */
    height: 190px; /* Altura de la imagen */
  }

  .hero-card:hover  {
    transform: scale(1.05); /* Amplía ligeramente la imagen */
    filter: brightness(1.1); /* Oscurece la imagen */
    box-shadow: 4px 4px 15px rgba(0, 0, 0, 0.5); /* Agrega un efecto de sombra */
  }
  h4{
    position: relative;
    height: 100px;
    display: flex;
    justify-content: center;
    width: 100%;
    text-transform: uppercase;
    font-size: 1.5rem;
    background: rgba(0,0,0, 0.3);
    align-items: center;
    min-height: 100px;
    color: white;
    transition: 0.3s ease-in-out;
    padding: 1rem;
    max-width: 275px;
    z-index: 1;
  }
  h4::before{
    content: "";
    position: absolute;
    inset: 0;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background-color: var(--accent-blue);
    transition:  0.2s  cubic-bezier(0.455, 0.03, 0.515, 0.955);
    z-index: -1;
  }
  .hero-card-container:hover h4::before { 
    transform: scaleX(1);
    box-shadow: 4px 4px 0px 0px var(--frame);
   }
  @media (max-width: 1345px) {
    h4::before{
    transform: scaleX(1);
    }
    .hero-card-container {
      padding: 1rem;
      gap: 1rem;
    }
    image {
      width: 160px; /* Ancho de la imagen */
      height: 160px; /* Altura de la imagen */
    }
  }
</style>


