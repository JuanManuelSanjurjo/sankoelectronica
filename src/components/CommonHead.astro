---
import { ClientRouter } from 'astro:transitions';
const { title, description, keywords } = Astro.props;
---

<head>
  <meta charset="UTF-8" />
  <meta name="description" content="Astro description" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/sanko-logo-svg.svg" />
  <link rel="icon" type="image/png" href="/sanko-logo-blanco.png" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description || 'Sanko Electronica'}>
  <meta name="keywords" content={keywords || 'sanko, electronica, naval, embalajes, girocompas, mar del plata, autopiloto, radar, sonar,sq800, pesca, calamar'}>
  <title>{title || "Sanko Electronica"}</title>
  <ClientRouter />
</head>
