---
import { ViewTransitions } from 'astro:transitions';
import logosanko from '../assets/images/sanko-logo-svg.svg';
import iconFallback from '../assets/images/sanko-logo-blanco.png';
const { title, description, keywords } = Astro.props;
---

<head>
  <meta charset="UTF-8" />
  <meta name="description" content="Astro description" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href={logosanko} />
  <link rel="icon" type="image/png" href={iconFallback} />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description || 'Sanko Electronica'}>
  <meta name="keywords" content={keywords || 'sanko, electronica, naval, embalajes, girocompas, autopiloto, pesca, calamar'}>
  <title>{title || "Sanko Electronica"}</title>
  <ViewTransitions />
</head>
