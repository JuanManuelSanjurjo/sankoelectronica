---
import {Image} from 'astro:assets';
import {getRelativeLocaleUrl} from 'astro:i18n';
import logosanko from '../assets/images/sanko-logo-blanco.png';
import LangSelect from './LangSelect.astro';
import Flags from './Flags.astro';
const { color } = Astro.props;
const currentLang = Astro.currentLocale || "es";


const rootUrl = currentLang === "en" ? "/en" : currentLang === "ja" ? "/ja" : "/"

const linkNames = {
  hamade: currentLang === "ja" ? "自家製" : "Hamade",
  pescaDeCalamar: currentLang === "ja" ? "カラマーの漁業" : currentLang === "en" ? "Squid fishing" : "Pesca de calamar",
  embalajes: currentLang === "ja" ? "エンブレム" : currentLang === "en" ? "Packaging" : "Embalajes",
  electronicaNaval: currentLang === "ja" ? "海外ナビル" : currentLang === "en" ? "Naval Electronics" : "Electronica Naval",
  girocompasesYAutopilotos: currentLang === "ja" ? "ギロコンパスとロボット" : currentLang === "en" ? "Gyrocompasses & Autopilots" : "Girocompases y Autopilotos",
}

---

<nav class="navbar" >
	<div class="navbar-content">
    <a href={rootUrl}>
      <Image class="logo" src={logosanko} alt="logo sanko electrica" width="100" height="100" />
      <div class="flag-container" >
        <!-- <span class="since">&#8275;  Desde 1977  &#8275;</span> -->
        <div class="flags">
          <Flags/>
        </div>
      </div>
		</a>
    <ul class="navbar-nav" >
      <li class="navbar-item" >
        <a  href={ getRelativeLocaleUrl(currentLang, "hamade")}  >{linkNames.hamade}</a>
      </li>
      <i>&bull;</i>
      <li class="navbar-item">
        <a href={ getRelativeLocaleUrl(currentLang, "pesca-de-calamar")}  >{linkNames.pescaDeCalamar}</a>
      </li>
      <i>&bull;</i>
      <li class="navbar-item">
        <a href={ getRelativeLocaleUrl(currentLang, "embalajes")}  >{linkNames.embalajes}</a>
      </li>
      <i>&bull;</i>
      <li class="navbar-item">
        <a  href={ getRelativeLocaleUrl(currentLang, "electronica-naval")}  >{linkNames.electronicaNaval}</a>
      </li>
      <i>&bull;</i>
			<li class="navbar-item" >
        <a  href={ getRelativeLocaleUrl(currentLang, "girocompases-y-autopilotos")}  >{linkNames.girocompasesYAutopilotos}</a>
			</li>
		</ul>
    <LangSelect />
	</div>
</nav>
<!-- <button class="navbar-toggle" onclick="toggleNavbar()"> -->
<button class="navbar-toggle" >
  <span>&#9776; </span>
  <span class="hidden-span">Sanko Electronica</span>
</button>

<style define:vars={{ color }}>
  a{
    display: flex;
    align-items: center;
    gap: 1rem;
    text-wrap: balance;
    padding-inline: 0.5rem;
  }
  i{
    font-style: normal;
    color: gray;
  }
  .since{
    font-size: 0.8rem;
    font-style: italic;
    text-align: left;
    font-weight: bold;
  }
  .flags{
    display:flex;
    align-items: center;
    gap: 0.5rem;
  }
  .flag-container{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin-inline: 1rem;
  }
  .logo{
    width: 76px;
    height: auto;
  }
	.navbar {
    position: sticky;
    top: 0;
    color: white;
    background-color: var(--black);
    /* background-color: #000000e8 ; */
    /* backdrop-filter: blur(10px); */
		padding: 0.75rem 1rem;
    z-index: 20;
    border-bottom: 1px solid var(--accent-dark);
	}
   .navbar-nav{
    display: flex;
    align-items: center;

  }
	.navbar-content {
		display: flex;
		align-items: center;
    justify-content: space-between;
	}
	.navbar-brand {
		display: flex;
		align-items: center;
    font-size: 1.5rem;
  }
	.navbar-brand img {
		margin-right: 0.5rem;
	}
	.navbar-item {
		/* margin-left: 1rem; */
		padding-block: 0.2rem;
		transition:  0.2s ease, color 0.2s ease;
  }
  a:not(.active) {
    color: white;
  }
  a.active {
    color: var(--accent-blue);
  }
	.navbar-item:hover {
		color: white;
	}
  .navbar-toggle {
    display: none;
    box-shadow: 0 0 6px -4px white;
    background-color: #000000e8;
  }

  @media (max-width: 1200px) {
    .navbar {
      position: fixed;
      inset: 0;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      transition: transform 0.2s ease;
      background-color: #000000e6;
      backdrop-filter: blur(10px);
    }
    .logo{
      width: 102px;
      height: auto;
    }
    i{
      display: none;
    }
    a{
      flex-direction: column;
    }
    .navbar-content{
      flex-direction: column;
      gap: 2em;
    }
    .navbar-close {
      transform: translateX(-100%);
    }
    .navbar-item {
      margin: 0.5rem 0;
    }
    .navbar-toggle {
      display: flex;
      position: fixed;
      align-items: end;
      right: 0;
      top: 5px;
      text-align: left;
      padding: 10px;
      z-index: 100;
      color: white;
      border: none;
      border-radius: 8px 0 0 8px ;
      width: 50px;
      transition: all 0.2s ease;
    }
    .active{
      width: 100%;
    }
    .navbar-toggle span:nth-child(1){
      padding-inline: 0.5rem;
    } 
    .hidden-span{
      display: none;
      white-space: nowrap;
      overflow: hidden;
      opacity:0;
    }
    .hidden{
      display: flex;
      opacity: 1;
      transition: opacity 0.8s ease;
    }
    .navbar-nav {
      flex-direction: column;
    }
  }
</style>


<script >
function setupNavbar() {
  const navbar = document.querySelector('.navbar');
  const btn = document.querySelector('.navbar-toggle');
  const hiddenSpan = document.querySelector('.hidden-span');
  const links = document.querySelectorAll('.navbar-nav a');

  if (!navbar || !btn) return;

  // 1. Manejo de links activos
  links.forEach((link) => {
    const path = new URL(link.href, window.location.origin).pathname;
    if (path === window.location.pathname && window.location.pathname.length > 3) {
      link.classList.add('active');
    } else {
      link.classList.remove('active');
    }
  });

  // 2. Forzar estado cerrado inmediatamente al cargar (Evita parpadeos en móvil)
  navbar.classList.add('navbar-close');
  btn.classList.remove('active');
  if (hiddenSpan) hiddenSpan.classList.remove('hidden');

  // 3. Definir la lógica de apertura y cierre
  function toggleNavbar() {
    navbar.classList.toggle('navbar-close');
    btn.classList.toggle('active');
    if (hiddenSpan) hiddenSpan.classList.toggle('hidden');
  }

  // 4. Asignar el evento correctamente desde JS (Elimina la necesidad de usar onclick en el HTML)
  btn.addEventListener('click', toggleNavbar);
}

// Se ejecuta en la primera carga limpia de la página (F5 / Entrada inicial)
document.addEventListener('DOMContentLoaded', setupNavbar);

// Se ejecuta en cada navegación de Astro ANTES de pintar la pantalla (Evita animaciones molestas)
document.addEventListener('astro:after-swap', setupNavbar);
</script>

