---
const isActive = (path) => {
  return path === Astro.url.pathname;
};
---

<nav class="navbar">
	<div class="navbar-content">
    <a href="/">
			<span class="text-gradient">Sanko Electronica</span>
		</a>
		<ul class="navbar-nav">
			<li class="navbar-item">
				<a href="/"  style={isActive("/") ? "color: var(--accent-light)" : ""}>Home</a>
			</li>
			<li class="navbar-item">
				<a href="/about">About</a>
			</li>
			<li class="navbar-item">
				<a href="/blog">Blog</a>
			</li>
		</ul>
	</div>
</nav>
<button class="navbar-toggle" onclick="toggleNavbar()">
  <span>&#9776; </span>
  <span class="hidden-span">Sanko Electronica</span>
</button>

<style>
	.navbar {
		display: flex;
    color: white;
		justify-content: space-between;
		padding: 0.75rem 1rem;
    background-color: var(--black);
    position: sticky;
    top: 0;
	}
   .navbar-nav{
    display: flex;
  }
	.navbar-content {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.navbar-brand {
		display: flex;
		align-items: center;
    font-size: 1.5rem;
  }
	.navbar-brand img {
		margin-right: 0.5rem;
	}
	.navbar-item {
		margin-left: 1rem;
		padding: 0.5rem;
		border-radius: 999px;
		transition: background-color 0.2s ease, color 0.2s ease;
	}
	.navbar-item:hover {
		color: white;
	}
	.navbar-item:active {
		background-color: var(--accent-dark);
		color: white;
  }
  .navbar-toggle {
    display: none;
  }

  @media (max-width: 768px) {
    .navbar {
      position: fixed;
      inset: 0;
      z-index: 10;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      transition: transform 0.2s ease;
    }

    .navbar-content{
      flex-direction: column;
      gap: 2em;
    }
    .navbar-close {
      transform: translateX(-100%);
    }
    .navbar-item {
      margin: 0.5rem 0;
    }
    .navbar-toggle {
      display: flex;
      position: absolute;
      align-items: end;
      right: 0;
      top: 5px;
      text-align: left;
      padding: 6px 9px;
      z-index: 100;
      color: white;
      background-color: var(--black);
      border: 1px solid gray;
      border-radius: 8px 0 0 8px ;
      width: 50px;
      transition: all 0.2s ease;
    }
    .active{
      width: 100%;
    }
    .navbar-toggle span:nth-child(1){
      padding-inline: 0.5rem;
    } 
    .hidden-span{
      display: none;
      white-space: nowrap;
      overflow: hidden;
      opacity:0;
    }
    .hidden{
      display: flex;
      opacity: 1;
      transition: opacity 0.8s ease;
    }
    .navbar-nav {
      flex-direction: column;
    }
  }
</style>


 <script> 
document.addEventListener('astro:page-load', () => {
  const navbar = document.querySelector('.navbar');
  const btn = document.querySelector('.navbar-toggle');
  const hiddenSpan = document.querySelector('.hidden-span');

  function toggleNavbar() {
    navbar.classList.toggle('navbar-close');
    btn.classList.toggle('active');
    hiddenSpan.classList.toggle('hidden');
  }

  // Inicializamos el estado del menú (cerrado) cuando la página se carga
  navbar.classList.add('navbar-close');
  btn.classList.remove('active');

  // Escuchar el evento del botón para abrir y cerrar el menú
  btn.addEventListener('click', toggleNavbar);

  // Si la navegación cambia, cerramos el menú, popstate trabaja la pila de navegación
  window.addEventListener('popstate', () => {
    navbar.classList.add('navbar-close');
    btn.classList.remove('active');
  });
})
 </script> 



