---
const isActive = (path) => {
  return path === Astro.url.pathname;
};
---

<nav class="navbar">
	<div class="navbar-content">
    <a href="/">
			<span class="text-gradient">Sanko Electronica</span>
		</a>
		<ul class="navbar-nav">
			<li class="navbar-item">
				<a href="/"  style={isActive("/") ? "color: var(--accent-light)" : ""}>Home</a>
			</li>
			<li class="navbar-item">
				<a href="/about">About</a>
			</li>
			<li class="navbar-item">
				<a href="/blog">Blog</a>
			</li>
		</ul>
	</div>
</nav>
<button class="navbar-toggle" onclick="toggleNavbar()">
  &#9776;
</button>

<style>
	.navbar {
		display: flex;
		justify-content: space-between;
		padding: 0.75rem 1rem;
    background-color: black;
    position: sticky;
    top: 0;
	}
   .navbar-nav{
    display: flex;
  }
	.navbar-content {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.navbar-brand {
		display: flex;
		align-items: center;
		font-size: 1.5rem;        
	}
	.navbar-brand img {
		margin-right: 0.5rem;
	}
	.navbar-brand span {
		font-weight: 700;
	}
	.navbar-item {
		margin-left: 1rem;
		padding: 0.5rem;
		border-radius: 999px;
		transition: background-color 0.2s ease, color 0.2s ease;
	}
	.navbar-item:hover {
		background-color: var(--accent-light);
		color: white;
	}
	.navbar-item:active {
		background-color: var(--accent-dark);
		color: white;
  }
  .navbar-toggle {
    display: none;
  }

  @media (max-width: 768px) {
    .navbar {
      position: fixed;
      inset: 0;
      z-index: 10;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      transition: transform 0.2s ease;
    }
    .navbar-content{
      flex-direction: column;
      gap: 2em;
    }
    .navbar-close {
      transform: translateX(-100%);
    }
    .navbar-item {
      margin: 0.5rem 0;
    }
    .navbar-toggle {
      display: block;
      position: absolute;
      right: 5px;
      top: 5px;
      padding: 6px 9px;
      z-index: 100;
      color: white;
      background-color: black;
      border: 1px solid white;
      border-radius: 5px
    }
    .navbar-nav {
      flex-direction: column;
    }
  }
</style>


 <script> 
 document.addEventListener('astro:page-load', () => { 
   const navbar = document.querySelector('.navbar'); 
   const btn = document.querySelector('.navbar-toggle'); 

   function toggleNavbar() { 
     navbar.classList.toggle('navbar-close'); 
   } 

   btn.addEventListener('click', toggleNavbar); 
   toggleNavbar();
   }) 
 </script> 



