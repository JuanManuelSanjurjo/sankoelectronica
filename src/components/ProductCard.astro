---
import { Image } from 'astro:assets';
import ContactButton from './ContactButton.astro';
import SecondaryButton from './SecondaryButton.astro';
const { title, image, alt, subject, style, color, href } = Astro.props;
---

<div class={`equipo ${style}`}>
  <h4>{title}</h4>
  <div>
    <Image transition:name={alt} src={image} alt={alt} width="200px" height="auto" />
    <slot/>
  </div>
  <div class="flex">
    { href &&
    <SecondaryButton href={href} subject={subject}>INFO</SecondaryButton>
    }
    <ContactButton subject={subject} />
  </div>
</div>


<style define:vars={{ color }}>
  h4{
    margin-block: 2rem;
    border-bottom: 1px solid var(--color);
  }
  div img{
    margin: 0;
  }
  div.flex {
    justify-content: flex-end;
  }
  .equipo  {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
  }
  .equipo div{
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  @media (max-width: 1150px) {
    .flex, .equipo div {
      flex-direction: column;
      gap: 1rem;
    }
  .equipo  {
    padding: 1rem;
  }

} 
</style>

