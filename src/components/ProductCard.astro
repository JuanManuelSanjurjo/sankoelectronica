---
import { Image } from 'astro:assets';
import ContactButton from './ContactButton.astro';
import SecondaryButton from './SecondaryButton.astro';
const { title, image, alt, subject, style, imgWidth, color, href} = Astro.props;
// 1. Obtener la ruta limpia que causó el error (ej: "/en/lo-que-sea")
const { pathname } = Astro.url;

// 2. Comprobar si la ruta empieza con el prefijo de tu idioma secundario
//    (Si tienes más idiomas, puedes usar un array y verificar con .includes())
const isEnglish = pathname.startsWith('/en/') || pathname === '/en';
const isJapanese = pathname.startsWith('/ja/') || pathname === '/ja';

// 3. Establecer el idioma definitivo de forma manual
const currentLang = isEnglish ? 'en' : isJapanese ? 'ja' : 'es';
---

<div class={`equipo ${style}`}>
  <h4>{title}</h4>
  <div>
    <Image class="img" transition:name={alt} src={image} alt={alt} width={imgWidth ? imgWidth : "200px"} height="auto" />
    <slot/>
  </div>
  <div class="flex">
    { href &&
    <SecondaryButton href={href} subject={subject}>{currentLang === "ja" ? "情報" :"Info"}</SecondaryButton>
    }
    <ContactButton subject={subject}>{currentLang === "en" ? "Contact" : currentLang === "ja" ? "連絡" : "Consultar"}</ContactButton>
  </div>
</div>


<style define:vars={{ color }}>
  h4{
    margin-block: 2rem;
    border-bottom: 1px solid var(--color);
  }
  div img{
    margin: 0;
  }
  div.flex {
    justify-content: flex-end;
  }
  .equipo  {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
  }
  .equipo div{
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  @media (max-width: 1150px) {
    .flex, .equipo div {
      flex-direction: column;
      gap: 1rem;
    }
  .equipo  {
    padding: 1rem;
  }
  .img{
      width: 250px;
      height: auto;
    }

} 
</style>

