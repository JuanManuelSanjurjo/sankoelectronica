---
const { color } = Astro.props
---

<div class="side-decoration" >
</div>

<style define:vars={{ color }}>
  .side-decoration {
    position: absolute;
    inset: 0;
    width: 20px;
    background-color: var(--color);
    box-shadow: 0px 0 2px 2px var(--color);
    z-index: -1;
  }
  @media (max-width: 768px) {
    .side-decoration {
      width:100%;
      height: 20px;
    }
  }
</style>
