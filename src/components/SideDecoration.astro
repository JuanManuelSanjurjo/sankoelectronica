---
const { color } = Astro.props
---

<div class="side-decoration" >
</div>

<style define:vars={{ color }}>
  .side-decoration {
    position: fixed;
    inset: 0;
    width: 20px;
    height: 100vh;
    background-color: var(--accent-blue);
    box-shadow: 0px 0 2px 2px var(--accent-blue);
    z-index: 5;
  }
  @media (max-width: 768px) {
    .side-decoration {
      position:absolute;
      width:100%;
      height: 20px;
    }
  }
</style>
