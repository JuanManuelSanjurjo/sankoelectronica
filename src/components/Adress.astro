---
const { pathname } = Astro.url;

const isEnglish = pathname.startsWith('/en/') || pathname === '/en';
const isJapanese = pathname.startsWith('/ja/') || pathname === '/ja';

const currentLang = isEnglish ? 'en' : isJapanese ? 'ja' : 'es';
const rootUrl = currentLang === "en" ? "/en" : currentLang === "ja" ? "/ja" : "/"

---
<div class="glass">
  <div class="adress">
    <p>Sanko Electrónica SRL </p>
    <p>{currentLang === "en" ? "Adress: " : currentLang === "ja" ? "住所: " : "Dirección: "} Irala 3241, 7600 Mar del Plata, Buenos Aires, Argentina</p>
    <p>{currentLang === "en" ? "Phone: " : currentLang === "ja" ? "電話: " : "Teléfono: "} +54 11 3711-3700</p>
    <p>E-mail: sankoelectronica@gmail.com</p>
  </div>
  <div class="content">
    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3142.0826196426924!2d-57.5482885!3d-38.045161199999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9584dd4ba8666ec3%3A0xf172fb4f1a6fa5f8!2sSanko%20Electronica%20SRL!5e0!3m2!1ses-419!2sar!4v1788537081888!5m2!1ses-419!2sar"  style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
</div>



<style>
  div.glass{
    padding-block: 1rem ;
  }
  .content{
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  p{
    font-weight: bold;
  }
  .adress{
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin-block: 2rem;
    width: 100%;
    gap: 10px;
  }
  iframe{
    width: 100%;
    height: 500px;
  }
</style>
