---
import { Image } from 'astro:assets';
import ContactButton from './ContactButton.astro';
import ProductCard from './ProductCard.astro';

const {title, image, alt, subject, color, id} = Astro.props;
---

<div id={id} class="anchor-target maintenance" >
  <div class="content">
    <ProductCard style="full" imgWidth="350px" color={color} title={title} image={image} alt={alt} subject={subject}>
      <slot/>
    </ProductCard>
  </div>
</div>

<style > 
 .maintenance {
   padding-block: 4rem;
 }
</style>


