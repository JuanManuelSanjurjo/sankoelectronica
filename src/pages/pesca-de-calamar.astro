---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { Image } from 'astro:assets';
import hamade from '../assets/images/hamade-my8.jpg';
import hamadelogo from '../assets/images/hamade-logo.png';
---

<Layout title="Pesca de calamar" color="var(--accent-red)">
	<main>
    <section>
      <div class="content">
        <h1>Pesca de calamar</h1>
        <p class="instructions">
          lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
          lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
        </p>
      </div>
      <div class="content content-cards">
        <div class="flex">
          <h2>Equipos</h2>
          <Image  src={hamadelogo} alt="Hamade" width="200px" height="auto" />
        </div>
        <ProductCard style="full" title="MY-8" image={hamade} alt="my-8" subject="Hamade MY-8" />
        <ProductCard style="full" title="MY-18" image={hamade} alt="my-8" subject="Hamade MY-8" />
      </div>

    </section>
    <section>
      <div class="content">
        <h2>Drum shape</h2>
        <div class="box">
          <p>Available in two types of HAMADE's original drums to meet customer needs.</p>
          <div class="flex">
              <h5>Diamon Shape</h5>
              <Image  src={hamade} alt="Hamade" width="200px" height="auto" />
              <p>A standard and common drum shape that allows for rhythmic up/down.
          </div>
        </div>
        <div >
          <h4>Mechanism of Automatic Squid Jigging/Fishing Machine</h4>
          <div class="flex">
            <div class="box">
              <h5>Significant labor savings</h5>
              <p>lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
            </div>
            <div class="box">
              <h5>Replicating the proficient techniques</h5>
              <p>lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
            </div>
            <div class="box">
              <h5>Minimizing troubles</h5>
              <p>lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
            </div>
          </div>
        </div>
      </div>
    </section>

	</main>
</Layout>


<style >
  h1 {
    text-decoration: var(--accent-red) underline;
  }
  h2, h4, h5{
    margin-block: 2rem;
  }
  h5{
    border-bottom: 1px solid white;
    padding-bottom: 0.6rem;
  }
  .flex {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .box .flex img{
    margin: 0;
    align-self: center;
  }
  .content-cards {
    display: flex;
    flex-direction: column;
    margin-block: 4rem;
    gap: 2rem;
  }
  .equipo  {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
    border-radius: 5px;
    background-color: var(--frame);
  }
  .equipo div{
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .box {
    border: 1px solid white;
    padding: 4rem 2rem;
    min-height: 500px;
  }
  @media (max-width: 1150px) {
    .flex, .equipo div {
      flex-direction: column;
      gap: 1rem;
    }
    .box {
      padding: 2rem;
      min-height: unset;
    }
} 
</style>

