---
import Layout from '../layouts/Layout.astro';
import HeroCards from '../components/HeroCards.astro';
import hamade from '../assets/images/hamade-my8.jpg';
import stapak from "../assets/images/strapaq-SQ-800.jpg"
import koden from "../assets/images/radar.jpg"
import autopiloto from "../assets/images/autopiloto.jpg"
---

<Layout title="Sanko Electronica" >
	<main>
    <h1>Sanko Electronica</h1>
    <section class="hero-cards">
      <HeroCards image={hamade} alt="Pesca de calamar" href="/pesca-de-calamar" />
      <HeroCards image={stapak} alt="Embalajes" href="/embalajes" />
      <HeroCards image={koden} alt="Electronica naval" href="electronica-naval" />
      <HeroCards image={autopiloto} alt="Girocompases y autopilotos" href="girocompases-y-autopilotos" />
    </section>
	</main>
</Layout>

<style define:vars={{ accentBlue: 'var(--accent-blue)' }}>
  h1 {
    text-decoration: var(--accentBlue) underline;
    margin: auto;
    text-align: center;
    padding: 4rem;
    color: white;
    background-color: rgba(0,0,0, 0.3);
  }
  main {
    background-image:  linear-gradient(to right, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.2)),
      url(https://images.locationscout.net/2019/06/banquina-de-pescadores-argentina.webp?h=1400&q=80);
    background-size: cover;
  }
  .hero-cards {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-top: 4rem;
    gap: 4rem;
  }
  @media (max-width: 1345px) {
    .hero-cards {
      flex-direction: column;
      align-items: center;
      margin-top: 0;
      gap: 2rem;
    }
    h1 {
      padding: 2rem;
    }
  }
</style>

