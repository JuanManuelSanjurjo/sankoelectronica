---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HeroCards from '../components/HeroCards.astro';
import ButtonNav from '../components/ButtonNav.astro';
import hamade from '../assets/images/hamade-my8.jpg';
import stapak from "../assets/images/strapaq-SQ-800.jpg"
import koden from "../assets/images/radar.jpg"
import autopiloto from "../assets/images/autopiloto.jpg"
import logosanko from '../assets/images/sanko-logo-blanco.png';

const sections = [
  { id: 'business', name: 'Business' },
  { id: 'about', name: 'About' },
  { id: 'partners', name: 'Partners' },
];
---

<Layout title="Sanko Electronica" >
  <ButtonNav sections={sections} />
	<main>
    <section id="business">
        <h1 class="glass">
          <Image class="logo" src={logosanko} alt="logo sanko electrica" width="180px" height="auto" />
          <span>Sanko Electronica</span>
        </h1>
      <div class="hero-cards">
        <HeroCards image={hamade} alt="Pesca de calamar" href="/pesca-de-calamar" />
        <HeroCards image={stapak} alt="Embalajes" href="/embalajes" />
        <HeroCards image={koden} alt="Electronica naval" href="electronica-naval" />
        <HeroCards image={autopiloto} alt="Girocompases y autopilotos" href="girocompases-y-autopilotos" />
      </div>
    </section>
    <section id="about">
      <div class="content">
        <h1>Sobre Nosotros</h1>
        <p class="glass">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
          Lorem ipsum dolor sit ame t, consectetur 
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
          elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
        </p>
      </div>
    </section>
    <section id="partners">
      <div class="content">
        <h1>Quienes confian en nosotros</h1>
        <p class="glass">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
          Lorem ipsum dolor sit ame t, consectetur 
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
          elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
        </p>
      </div>
    </section>
	</main>
</Layout>

<style >
  a{
    text-decoration: none;
  }
  section{
    padding-block: unset;
  }
  h1 {
    background-color: var(--frame);
    margin: auto;
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    color: white;
  }
  #about{
    padding-top: 8rem;
  }
  .content p {
    padding: 4rem 2rem;
  }
  main {
    background-image:
      linear-gradient(to bottom, rgba(0,110,240,0.3), rgba(256,0,0, 0.10)),
      url(https://images.locationscout.net/2019/06/banquina-de-pescadores-argentina.webp?h=1401&q=80);
    background-size: cover;
    background-attachment: fixed;
  }
  .hero-cards {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 4rem;
    padding-block:4rem;
  }
  @media (max-width: 1345px) {
    .hero-cards {
      margin-top: 0;
      gap: 2rem;
    }
    h1 {
      padding: 2rem;
    }
    h1 span {
      display: none;
    }
  }
@media (max-width: 1150px) {
    .hero-cards {
      flex-direction: column;
      align-items: center;
    }
    h1{
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }
</style>

