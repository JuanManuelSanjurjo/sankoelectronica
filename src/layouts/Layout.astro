---
import "../globals.css";
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommonHead from '../components/CommonHead.astro';
import SideDecoration from '../components/SideDecoration.astro';
import Whatsapp from '../components/Whatsapp.astro';
const { title, color, description, keywords } = Astro.props;

---

<!doctype html>
<html lang="en">
  <CommonHead title={title} description={description} keywords={keywords} />
  <body>
    <Navbar color={color} transition:persist />
		<slot />
    <Footer />
    <SideDecoration color={color} />
    <Whatsapp />
	</body>
</html>


