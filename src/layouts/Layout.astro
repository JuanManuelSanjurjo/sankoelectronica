---
import "../globals.css";
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommonHead from '../components/CommonHead.astro';
import SideDecoration from '../components/SideDecoration.astro';
const { title, color } = Astro.props;
---

<!doctype html>
<html lang="en">
  <CommonHead title={title} />
	<body>
    <Navbar />
		<slot />
    <Footer />
    <SideDecoration color={color} />
	</body>
</html>

<style>
  main {
    padding: 2rem;
    flex: 1;
    display: flex;
    max-width: 800px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
</style>
